# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CWA_API_KEY: Central Weather Administration API Key (Taiwan)
# Get yours at: https://opendata.cwa.gov.tw/user/authkey
VITE_CWA_API_KEY="YOUR_CWA_API_KEY"

# Notion database for user outfit/weather records.
# Keep NOTION_API_KEY server-side only if you add a backend write endpoint.
NOTION_API_KEY="YOUR_NOTION_INTERNAL_INTEGRATION_SECRET"
NOTION_DATABASE_ID="56ab0600c82d82d2b61a81e11e73531f"
NOTION_DATA_SOURCE_ID="6b2b0600-c82d-82f2-9b7c-07c4b4fe5b8c"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
